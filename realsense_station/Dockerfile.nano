# ---------------------------------------------------------------------------
# Lean RealSense-only image for the Orin Nano (no CUDA / TensorRT / NanoOWL).
#
# The RealSense depth demos only need: librealsense + pyrealsense2, OpenCV
# (with FaceDetectorYN/FaceRecognizerSF, i.e. >= 4.5.4), numpy, cryptography.
# librealsense is built with the userspace RSUSB backend so it works in a
# container without kernel modules, on any JetPack.
#
#   docker build -f Dockerfile.nano -t realsense-nano:demo .
#
# Build takes ~20-40 min on a Nano (compiles librealsense). One-time.
# ---------------------------------------------------------------------------
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake build-essential pkg-config ca-certificates \
      libssl-dev libusb-1.0-0-dev libudev-dev \
      python3 python3-dev python3-pip python3-numpy python3-opencv \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir cryptography

# ---- build librealsense + python bindings (RSUSB userspace backend) ----
ARG LRS_VERSION=v2.55.1
RUN git clone --depth 1 --branch ${LRS_VERSION} \
        https://github.com/IntelRealSense/librealsense /tmp/lrs \
    && cd /tmp/lrs && mkdir build && cd build \
    && cmake .. \
        -DFORCE_RSUSB_BACKEND=true \
        -DBUILD_PYTHON_BINDINGS=true \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_EXAMPLES=false \
        -DBUILD_GRAPHICAL_EXAMPLES=false \
        -DPYTHON_EXECUTABLE=$(which python3) \
    && make -j"$(nproc)" && make install && ldconfig \
    # librealsense's `make install` ships pyrsutils + cmake configs but NOT the
    # main pyrealsense2 module or an __init__.py, so the package imports EMPTY
    # (rs.align/pipeline missing). Install the built main .so + a re-export
    # __init__.py ourselves, then hard-verify the real symbols are present.
    && cp -v "$(find /tmp/lrs/build -name 'pyrealsense2.cpython-*.so' | head -1)" \
             /usr/lib/python3/dist-packages/pyrealsense2/ \
    && printf 'from .pyrealsense2 import *\n' \
             > /usr/lib/python3/dist-packages/pyrealsense2/__init__.py \
    && python3 -c "import pyrealsense2 as rs; \
assert all(hasattr(rs,a) for a in ('align','pipeline','config','stream','pointcloud','context')), \
'pyrealsense2 binding INCOMPLETE'; print('pyrealsense2 FULL OK: align/pipeline/pointcloud present')" \
    && rm -rf /tmp/lrs

# librealsense installs the pyrealsense2 .so under /usr/lib or /usr/local/lib
ENV PYTHONPATH=/usr/local/lib:/usr/lib/python3/dist-packages
WORKDIR /app

# Ubuntu 22.04's apt OpenCV is 4.5.4 -- too old for the shipped YuNet model
# (its FaceDetectorYN throws "Layer id=-1 not found" per frame). Replace it with
# a >=4.8 wheel, matching the booth/reception OpenCV so the SFace embeddings stay
# byte-comparable. Kept as a late layer so the librealsense compile stays cached.
# Purge BOTH apt opencv (4.5.4) and apt numpy (1.21.5, shadows pip via PYTHONPATH
# and is too old for cv2 4.8's typing -> "numpy._DTypeMeta not subscriptable").
# pip's numpy 1.26 + opencv 4.8.1 then win cleanly (matches reception's stack).
RUN apt-get purge -y python3-opencv python3-numpy 2>/dev/null || true; \
    pip3 install --no-cache-dir "numpy<2" "opencv-python-headless==4.8.1.78" \
    && python3 -c "import numpy, cv2; print('numpy', numpy.__version__, '| cv2', cv2.__version__); assert hasattr(cv2,'FaceDetectorYN_create') and hasattr(cv2,'FaceRecognizerSF_create'), 'missing face APIs'"

# Sanity: fail the build if the bindings can't import.
RUN python3 -c "import pyrealsense2 as rs, cv2, numpy, cryptography; \
assert all(hasattr(rs,a) for a in ('align','pipeline','config','stream','pointcloud','context')), 'pyrealsense2 binding INCOMPLETE'; \
assert hasattr(cv2,'FaceDetectorYN') and hasattr(cv2,'FaceRecognizerSF'), 'OpenCV missing face APIs'; \
print('OK | pyrealsense2 align+pipeline+pointcloud present | cv2', cv2.__version__, '| FaceDetectorYN/SF present')"

# The app (station.py, web/, models/) is bind-mounted at run time (-v .:/app).
CMD ["python3", "station.py"]
