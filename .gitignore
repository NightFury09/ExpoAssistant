# ROS 2 / colcon build artifacts, in both workspaces. They hold absolute paths
# and compiled binaries for the machine that built them, so every rebuild
# rewrote hundreds of tracked files. A fresh clone builds them -- see README.md.
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
uros_ws/build/
uros_ws/install/
uros_ws/log/

# PlatformIO build artifacts
.pio/

# Python bytecode
__pycache__/
*.pyc

# Saved maps (regenerable output).
# EXCEPTION: maps under the package's own maps/ dir that a launch file DEPENDS
# on are force-added -- master_navigation.launch.py defaults to room_map_v6.yaml,
# so a fresh clone must have it or the launch fails.
maps/

# Working backups taken while editing. Git already has the history; these are
# session scratch and should not accumulate in the repo.
# EXCEPTION: main.cpp.bak-openloop is force-added -- a comment in main.cpp
# points at it as the reference for the old dead-reckoning odometry.
*.bak
*.bak-*
*.v1

# Launch logs are runtime noise. demo_waypoints.yaml is NOT ignored: the demo
# points are the expo deliverable and this repo doubles as the crash backup.
logs/
*.pre-console
